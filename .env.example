# ---------------------------------------------------------------------------
# Hostel Water Leak Detector — SMS Notification Configuration
# Copy this file to .env and replace placeholder values with your credentials.
# Never commit actual credentials to version control.
# ---------------------------------------------------------------------------

# Twilio Account SID (found in Twilio Console: https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Twilio Auth Token (found in Twilio Console)
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Twilio Sender Phone Number (E.164 format, e.g. +12345678901)
TWILIO_PHONE_NUMBER=+12345678901

# Warden / Recipient Phone Number for Leak Notifications (E.164 format, e.g. +19876543210)
WARDEN_PHONE_NUMBER=+19876543210
